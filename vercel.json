{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "exam-seating-backend": {
      "root": "exam-seating-backend",
      "framework": "express"
    },
    "exam-seating-frontend": {
      "root": "exam-seating-frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/exam-seating-backend/api/$1" },
    { "source": "/(.*)", "destination": "/exam-seating-frontend/$1" }
  ]
}